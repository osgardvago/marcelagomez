    <!-- Trigger Button -->
<!--    <button id="botonModal" class="w-full h-10 bg-white hover:bg-white/50" >Open Website</button>-->

    <!-- Modal Overlay Container -->
    <div id="urlModal" class="w-full h-full grid grid-cols-4 bg-midnight/85 hidden z-1000 bottom-0 fixed p-5">
        <div class="col-span-4 md:col-span-2 md:col-start-2 h-4/5 bg-white shadow-lg rounded-xl flex justify-center mt-10 outline-2 outline-white/80 outline-offset-3">
            <span class="close-btn" id="closeMod">&times;</span>
            <!-- Input target URL into the src attribute -->
            <iframe id="modalIframe" class="w-full h-full" src=""  frameborder="0" loading="lazy"></iframe>
        </div>
    </div>

<script>
    // 1. Declarar correctamente todas las referencias
    const botonMod = document.getElementById('botonModal');
    // const botonModalNav = document.getElementById('botonModalNav');
    const modal = document.getElementById('urlModal');
    const iframe = document.getElementById('modalIframe') as HTMLIFrameElement; // Cast para TypeScript si usas Astro por defecto
    const botonCerrar = document.getElementById('closeMod');

    const targetUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ3KzxUEqBz0fQgOrNg0mcnp6ePjZFv3WaiIV3RM3eDENGsB5jkvfz0j6EKxzyjzhaTPwnuGsCHr?gv=true";

    // Función para abrir el modal
    function openModal() {
        if (modal && iframe) {
            modal.classList.remove('hidden');
            iframe.src = targetUrl;
        }
    }

    // Función para cerrar el modal
    function closeModal() {
        if (modal && iframe) {
            modal.classList.add('hidden');
            iframe.src = ""; // Limpia el iframe para detener procesos en segundo plano
        }
    }

    // 2. Asignar los listeners de forma segura
    if (botonMod) botonMod.addEventListener('click', openModal);
    // if (botonModalNav) botonModalNav.addEventListener('click', openModal);
    if (botonCerrar) botonCerrar.addEventListener('click', closeModal);

    // 3. ERROR 2 SOLUCIONADO: Listener específico para el overlay en vez de 'window'
    if (modal) {
        modal.addEventListener('click', (event) => {
            // Si el usuario hace clic exactamente en el fondo negro (overlay) y no en el contenido interno
            if (event.target === modal) {
                closeModal();
            }
        });
    }
</script>

    <style>
        /* Trigger button styling */
        .open-btn {
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
        }

        /* 1. The Dimmed Overlay Background */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7); /* Dimmed backdrop */
            display: none;                  /* Hidden by default */
            justify-content: center;
            align-items: center;
            z-index: 1000;                  /* Sit on top of everything */
        }

        /* 2. The Modal Box Wrapper */
        .modal-box {
            background: #fff;
            width: 80%;
            max-width: 900px;
            height: 80vh;
            border-radius: 8px;
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        /* 3. The Close Button */
        .close-btn {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 33px;
            font-weight: bold;
            color: #999;
            cursor: pointer;
            z-index: 1010;
        }

    </style>

